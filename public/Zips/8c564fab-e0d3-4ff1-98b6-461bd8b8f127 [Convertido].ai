         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Law and justice line icon set. 20 outline symbols including gavel, scales, judge, courthouse, handcuffs, and legal documents for web and app design.</rdf:li>
            </rdf:Alt>
